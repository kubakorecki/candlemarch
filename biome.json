{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/content/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@candlemarch/*", "pixi.js", "react", "react-dom", "node:*"],
                    "message": "content may not import anything (see CLAUDE.md import rules)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/sim/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@candlemarch/client", "pixi.js", "react", "react-dom", "node:*"],
                    "message": "sim may import content only (see CLAUDE.md import rules)."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "sim must be deterministic: no wall-clock time.",
                  "performance": "sim must be deterministic: no wall-clock time.",
                  "setTimeout": "sim advances only through step().",
                  "setInterval": "sim advances only through step().",
                  "queueMicrotask": "sim advances only through step().",
                  "fetch": "sim does no I/O.",
                  "localStorage": "sim does no I/O.",
                  "crypto": "use the seeded PRNG in state."
                }
              }
            }
          }
        }
      }
    }
  ]
}
